# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PWD=changeme
POSTGRES_DB=postgres
POSTGRES_PORT=15432

# Catalog service
CATALOG_DB=catalog-db
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=changeme

# Local connection: IntelliJ runs the app on your computer
CATALOG_DB_URL_LOCAL=jdbc:postgresql://localhost:15432/catalog-db

# Docker connection: app runs inside Docker
CATALOG_DB_URL_DOCKER=jdbc:postgresql://catalog-db:5432/catalog-db

# Future services
ORDER_DB=order-db
INVENTORY_DB=inventory-db
